# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://campuscircle:campuscircle_dev_pw@127.0.0.1:5432/campuscircle

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_MINUTES=10080
# 10080 minutes = 7 days

# CORS - the URL your frontend is served from (the FastAPI app also serves it directly by default)
CLIENT_ORIGIN=http://localhost:8000

# Admin bootstrap (used only by the seed script)
ADMIN_EMAIL=admin@campuscircle.edu
ADMIN_PASSWORD=Admin@12345
